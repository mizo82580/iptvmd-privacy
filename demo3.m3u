#EXTINF:-1 tvg-logo="https://raw.githubusercontent.com/mizo82580/iptvmd-privacy/main/UPLOAD-iptvmd-pd/iptvmd-pd/posters/f03.jpg" tvg-plot="رجل يروي كيف وصل عرض متجول إلى مدينته، وكيف بدأت الجرائم مع وصوله. جدران مائلة وظلال مرسومة باليد وحكاية لا تثق فيها بالراوي — الفيلم الذي وضع أساس السينما التعبيرية." tvg-year="1920" tvg-genre="رعب • تعبيرية" group-title="الأفلام",عيادة الدكتور كاليغاري
